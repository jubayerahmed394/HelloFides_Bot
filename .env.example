# Copy this file to ".env" for LOCAL testing only (never commit the real ".env").
# In GitHub Actions these same values are set as GitHub Secrets instead - see README.md.

TELEGRAM_BOT_TOKEN=123456789:put-your-botfather-token-here
# The single delivery destination: your private "HelloFides" channel's ID
# (looks like -1001234567890). The bot must be a channel admin.
TELEGRAM_CHANNEL_ID=-100put-your-channel-id-here
# Optional - your own numeric Telegram user ID, used only for error
# notifications if a scheduled post fails. Leave blank to skip those.
TELEGRAM_OWNER_CHAT_ID=
GEMINI_API_KEY=your-gemini-api-key
# Optional but recommended - fallback providers, tried only if Gemini is
# unavailable (rate-limited, down, or unset). Sign up free, no card needed:
#   Groq:    https://console.groq.com/keys
#   Mistral: https://console.mistral.ai/api-keys
# Leave either blank to skip it - it's just removed from the fallback chain,
# never an error. See README.md "Content generation resilience".
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key
PIXABAY_API_KEY=your-pixabay-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
