# Copy this file to ".env" for LOCAL testing only (never commit the real ".env").
# In GitHub Actions these same three values are set as GitHub Secrets instead - see README.md.

TELEGRAM_BOT_TOKEN=123456789:put-your-botfather-token-here
TELEGRAM_CHAT_ID=your-numeric-telegram-user-id
GEMINI_API_KEY=your-gemini-api-key
